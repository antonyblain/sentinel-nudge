{
  "name": "sentinel-nudge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0",
  "description": "Extension navigateur Chrome MV3 de cyber-hygiène comportementale",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-assets.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check-licenses": "license-checker --production --excludePackages sentinel-nudge@1.0.0 --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;MPL-2.0\""
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^3.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.44.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "jsdom": "^29.0.2",
    "license-checker": "^25.0.1",
    "playwright-crx": "^0.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-web-extension": "^4.5.0",
    "vitest": "^2.0.0"
  }
}
