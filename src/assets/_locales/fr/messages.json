  },
  "module_m3_name": {
    "message": "Score de cyber-hygiène (M3)",
    "description": "Nom du module M3"
  },
  "module_m3_desc": {
    "message": "Calcule votre score de cyber-hygiène chaque lundi et met à jour le badge de l'extension.",
    "description": "Description du module M3"
  },
  "module_m5_name": {
    "message": "Mise à jour navigateur (M5)",
    "description": "Nom du module M5"
  },
  "module_m5_desc": {
    "message": "Vous rappelle de mettre à jour votre navigateur lorsqu'une mise à jour est disponible.",
    "description": "Description du module M5"
  },
  "module_m6_name": {
    "message": "Quiz phishing (M6)",
    "description": "Nom du module M6"
  },
  "module_m6_desc": {
    "message": "Mini-quiz périodique pour reconnaître les tentatives de phishing. Utilise la répétition espacée.",
    "description": "Description du module M6"
  },
  "module_m7_name": {
    "message": "Réutilisation de mots de passe (M7)",
    "description": "Nom du module M7"
  },
  "module_m7_desc": {
    "message": "Détecte si vous réutilisez le même mot de passe sur plusieurs sites. Requiert consentement explicite.",
    "description": "Description du module M7"
  },
  "module_m9_name": {
    "message": "Force des mots de passe (M9)",
    "description": "Nom du module M9"
  },
  "module_m9_desc": {
    "message": "Affiche un indicateur de force lors de la création d'un mot de passe avec des suggestions d'amélioration.",
    "description": "Description du module M9"
  },
  "module_m17_name": {
    "message": "Données sensibles presse-papiers (M17)",
