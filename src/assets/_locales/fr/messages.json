  "onboarding_step1_title": {
    "message": "Bienvenue sur Sentinel Nudge",
    "description": "Titre étape 1"
  },
  "onboarding_step1_intro": {
    "message": "Sentinel Nudge est une extension de cyber-hygiène comportementale. Elle vous aide à adopter de meilleures habitudes de sécurité grâce à des micro-nudges contextuels basés sur la recherche en sciences comportementales.",
    "description": "Introduction étape 1"
  },
  "onboarding_step1_privacy_title": {
    "message": "Privacy by design",
    "description": "Titre section privacy étape 1"
  },
  "onboarding_step1_privacy_desc": {
    "message": "Tout traitement est effectué localement sur votre ordinateur. Aucune donnée ne quitte votre navigateur. Aucune télémétrie. Code source ouvert et auditable.",
    "description": "Description privacy étape 1"
  },
  "onboarding_step1_opensource": {
    "message": "Open source — licence GPL v3",
    "description": "Mention open source étape 1"
  },
  "onboarding_step2_title": {
    "message": "Choisissez votre profil",
    "description": "Titre étape 2"
  },
  "onboarding_step2_desc": {
    "message": "Votre profil influence la difficulté des quiz de sensibilisation (module M6). Vous pouvez le modifier à tout moment dans les paramètres.",
    "description": "Description étape 2"
  },
  "onboarding_step3_title": {
    "message": "Activez les modules",
    "description": "Titre étape 3"
  },
  "onboarding_step3_desc": {
    "message": "Chaque module surveille un aspect de votre cyber-hygiène. Tous sont actifs par défaut. Le module M7 requiert un consentement explicite à l'étape suivante.",
    "description": "Description étape 3"
  },
  "onboarding_step4_title": {
    "message": "Consentement M7 — Hachage de mots de passe",
    "description": "Titre étape 4"
  },
  "onboarding_step4_desc": {
    "message": "Le module M7 détecte la réutilisation de mots de passe. Pour cela, il calcule une empreinte (hash) locale de vos mots de passe. Cette empreinte est chiffrée et ne quitte jamais votre navigateur.",
    "description": "Description étape 4"
  },
  "onboarding_step4_consent_label": {
    "message": "J'accepte que Sentinel Nudge calcule des empreintes locales de mes mots de passe pour détecter les réutilisations",
    "description": "Label consentement M7"
  },
  "onboarding_step4_privacy_link": {
    "message": "Lire la politique de confidentialité",
    "description": "Lien politique de confidentialité"
  },
  "onboarding_profile_required": {
    "message": "Veuillez sélectionner un profil avant de continuer.",
    "description": "Erreur profil manquant"
  },
