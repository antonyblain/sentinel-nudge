  "onboarding_step1_title": {
    "message": "Welcome to Sentinel Nudge",
    "description": "Step 1 title"
  },
  "onboarding_step1_intro": {
    "message": "Sentinel Nudge is a behavioral cyber-hygiene extension. It helps you adopt better security habits through contextual micro-nudges based on behavioral science research.",
    "description": "Step 1 introduction"
  },
  "onboarding_step1_privacy_title": {
    "message": "Privacy by design",
    "description": "Step 1 privacy section title"
  },
  "onboarding_step1_privacy_desc": {
    "message": "All processing is done locally on your computer. No data leaves your browser. No telemetry. Open source and auditable code.",
    "description": "Step 1 privacy description"
  },
  "onboarding_step1_opensource": {
    "message": "Open source — GPL v3 license",
    "description": "Step 1 open source mention"
  },
  "onboarding_step2_title": {
    "message": "Choose your profile",
    "description": "Step 2 title"
  },
  "onboarding_step2_desc": {
    "message": "Your profile influences the difficulty of security awareness quizzes (module M6). You can change it at any time in Settings.",
    "description": "Step 2 description"
  },
  "onboarding_step3_title": {
    "message": "Activate modules",
    "description": "Step 3 title"
  },
  "onboarding_step3_desc": {
    "message": "Each module monitors one aspect of your cyber-hygiene. All are active by default. Module M7 requires explicit consent in the next step.",
    "description": "Step 3 description"
  },
  "onboarding_step4_title": {
    "message": "M7 Consent — Password hashing",
    "description": "Step 4 title"
  },
  "onboarding_step4_desc": {
    "message": "Module M7 detects password reuse. To do this, it computes a local hash of your passwords. This hash is encrypted and never leaves your browser.",
